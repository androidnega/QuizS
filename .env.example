APP_NAME=QuizSnap
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/QuizSnap/public

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=QuizSnap
DB_USERNAME=root
DB_PASSWORD=

OPENAI_API_KEY=

# Staff accounts (admin + examiners). Created in DB when you run: php artisan db:seed
# No hardcoded credentials; set these and seed, then add more users via Dashboard → User management.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=

# One examiner from env (optional)
EXAMINER_USERNAME=
EXAMINER_PASSWORD=
EXAMINER_NAME=
EXAMINER_COURSE_ID=

# More examiners: EXAMINER_1_USERNAME, EXAMINER_1_PASSWORD, EXAMINER_1_NAME, EXAMINER_1_COURSE_ID, then EXAMINER_2_..., etc.

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

# Reverb (WebSockets) - run: php artisan reverb:start
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=quizsnap
REVERB_APP_KEY=quizsnap-key
REVERB_APP_SECRET=quizsnap-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
